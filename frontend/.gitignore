# ==========================================================
# LUMORA - Full Stack (React + FastAPI) .gitignore
# ==========================================================

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
venv/
env/
ENV/
.venv/

# Python Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =========================
# Pytest / Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# =========================
# SQLite / Databases
# =========================
*.db
*.sqlite
*.sqlite3

# =========================
# Runtime Data
# =========================
data/raw_docs/
data/vector_store/
data/uploads/
data/temp/

# Keep empty folders if using .gitkeep
!data/.gitkeep
!data/raw_docs/.gitkeep
!data/vector_store/.gitkeep

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Node
# =========================
node_modules/
frontend/node_modules/

dist/
frontend/dist/
dist-ssr/

# =========================
# Build Output
# =========================
build/
coverage/

# =========================
# IDE
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# =========================
# Operating System
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Temporary Files
# =========================
*.tmp
*.temp
*.bak
*.swp
*.swo
*.local

# =========================
# Reports / Generated Files
# =========================
report.pdf
*.pdf.tmp

# =========================
# Misc
# =========================
.cache/
.eslintcache